<Project Sdk="Microsoft.NET.Sdk">
  <!--
    RearViewCamera mod. Everything shared by the user's mods (references from E:\Projects\Valheim\Claude\ref, net48, no debug symbols,
    the shared code Kydl.Common / Kydl.Ui, copy to Assets + build, embedded bundle) comes from Claude\shared\Kydl.Mod.props / .targets.
    Add here only what is special about this mod (an extra reference: put the DLL into Claude\ref and add a line below).
    Build: dotnet build "RearViewCamera-Mod\RearViewCamera.csproj" -c Release
  -->
  <Import Project="..\..\Claude\shared\Kydl.Mod.props" />

  <PropertyGroup>
    <AssemblyName>RearViewCamera</AssemblyName>
    <RootNamespace>RearViewCamera</RootNamespace>
    <PackageId>RearViewCamera</PackageId>
    <!-- AssetBundle built by the Unity project (Valheim > Build AssetBundles); embedded into the DLL when Assets\rearviewcamera exists -->
    <BundleName>rearviewcamera</BundleName>
    <!-- 2.0.0: the UI kit, the input lock and the KY hub come from KydlCore.dll (a hard dependency), not from a copy in this DLL -->
    <KydlUseCore>true</KydlUseCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- the game's post-processing stack (v1): the rear camera copies the game's colour grading (D-022) -->
    <!-- the game's Input System bindings: key-conflict check (R12, D-035) -->
    <Reference Include="Unity.InputSystem"><HintPath>$(ValheimRefs)\Unity.InputSystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="assembly_postprocessing"><HintPath>$(ValheimRefs)\assembly_postprocessing.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- the mod's menu views live in the Unity project (previewed there) and are compiled into the mod from there -->
    <Compile Include="..\RearViewCamera-Unity\Assets\RearViewCamera_UI\Runtime\*.cs" Link="UiViews\%(Filename)%(Extension)" />
  </ItemGroup>

  <Import Project="..\..\Claude\shared\Kydl.Mod.targets" />
</Project>
